#!/bin/sh
# 每次 commit 之后自动推送到 GitHub。
#
# 启用方式（在仓库里执行一次）：
#     git config core.hooksPath .githooks
#
# 设计原则：推送失败绝不影响提交本身 —— 提交是本地事实，推送是尽力而为。
# 想临时跳过：git commit --no-verify 或 git -c core.hooksPath= commit
#
# 为什么要重试两次：本机可能挂着代理（http.proxy=http://127.0.0.1:7890），
# 代理节点一挂，git 就走 schannel 握手失败；反过来直连在有些网络下又不通。
# 所以两条路都试一遍，哪条通用哪条，别让一次提交因为网络姿势没对上就丢了推送。

set -e

# 合并/变基过程中不推（历史还没定下来）
if [ -f "$(git rev-parse --git-dir)/MERGE_HEAD" ] || [ -d "$(git rev-parse --git-dir)/rebase-merge" ]; then
    exit 0
fi

remote=$(git remote get-url origin 2>/dev/null) || exit 0
[ -z "$remote" ] && exit 0

branch=$(git symbolic-ref --short HEAD 2>/dev/null) || exit 0
[ -z "$branch" ] && exit 0

upstream=$(git rev-parse --abbrev-ref --symbolic-full-name "@{upstream}" 2>/dev/null) || upstream=""

echo ""
echo "  [post-commit] 自动推送到 GitHub：$branch → origin"

# 第一趟：按仓库现有配置推（可能走代理）
# 注意用 if 包起来：`cmd && ok=1` 在 set -e 下会不会中止脚本，各家 shell 说法不一，
# if 的条件部分则是明确豁免的，稳。
ok=0
how="按现有配置"
if [ -n "$upstream" ]; then
    if git push origin "$branch" >/dev/null 2>&1; then ok=1; fi
else
    if git push -u origin "$branch" >/dev/null 2>&1; then ok=1; fi
fi

# 第二趟：绕过代理直连（代理节点挂了的时候这条能救回来）
if [ "$ok" -ne 1 ]; then
    echo "  [post-commit] 第一次没推上去，换成绕过代理直连再试…"
    how="绕过代理直连"
    if [ -n "$upstream" ]; then
        if git -c http.proxy= -c https.proxy= push origin "$branch" >/dev/null 2>&1; then ok=1; fi
    else
        if git -c http.proxy= -c https.proxy= push -u origin "$branch" >/dev/null 2>&1; then ok=1; fi
    fi
fi

if [ "$ok" -eq 1 ]; then
    echo "  [post-commit] ✅ 已推送 $(git rev-parse --short HEAD)（$how）→ $remote"
else
    echo "  [post-commit] ⚠️ 两种方式都没推上去（网络/权限？）—— 提交本身没问题，稍后手动："
    echo "                     git push origin $branch"
    echo "                     git -c http.proxy= -c https.proxy= push origin $branch"
fi

exit 0
